{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified Phase 6 trace v6.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "query",
    "routing",
    "retrieval",
    "generation",
    "validation",
    "abstention",
    "result",
    "latency",
    "lower_level",
    "schema_version",
    "trace_id",
    "timestamp",
    "tools",
    "failure_attribution"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ]
    },
    "query": {
      "type": "object",
      "required": [
        "id",
        "text",
        "policy"
      ]
    },
    "routing": {
      "type": "object",
      "required": [
        "decision",
        "reason",
        "tools_selected",
        "correct",
        "latency_seconds"
      ],
      "properties": {
        "latency_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": [
        "configuration",
        "evidence",
        "latency_seconds",
        "latency_source",
        "evidence_sufficient",
        "sufficiency_basis"
      ],
      "properties": {
        "latency_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "configuration",
        "status",
        "latency_seconds",
        "token_usage"
      ],
      "properties": {
        "token_usage": {
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "latency_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "json_schema_valid",
        "output_contract_valid",
        "citation_valid",
        "errors",
        "details",
        "latency_seconds"
      ],
      "properties": {
        "latency_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "abstention": {
      "type": "object",
      "required": [
        "observed",
        "expected",
        "correct"
      ],
      "properties": {
        "observed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "expected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "correct": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "orchestration_status",
        "validation_status",
        "evidence_sufficient",
        "claims_supported",
        "answer",
        "citations"
      ]
    },
    "latency": {
      "type": "object",
      "required": [
        "end_to_end_seconds",
        "recorded_seconds",
        "recorded_scope",
        "orchestration_seconds",
        "tool_seconds"
      ]
    },
    "lower_level": {
      "type": "object",
      "required": [
        "orchestration_status",
        "generation_status",
        "error",
        "legacy_attribution",
        "attempts"
      ]
    },
    "schema_version": {
      "const": "6.1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "latency_seconds",
          "error",
          "evidence"
        ]
      }
    },
    "failure_attribution": {
      "type": "object",
      "required": [
        "primary",
        "categories"
      ],
      "properties": {
        "primary": {
          "enum": [
            null,
            "success",
            "expected_abstention",
            "unsupported_query",
            "retrieval_failure",
            "tool_failure",
            "routing_failure",
            "generation_failure",
            "citation_failure",
            "invalid_output",
            "partial_evidence"
          ]
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "success",
              "expected_abstention",
              "unsupported_query",
              "retrieval_failure",
              "tool_failure",
              "routing_failure",
              "generation_failure",
              "citation_failure",
              "invalid_output",
              "partial_evidence"
            ]
          }
        }
      }
    }
  }
}
